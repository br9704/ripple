{
  "name": "ripple",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Anonymous civic infrastructure reporting PWA. On-device AI classification, live community map, council dashboard.",
  "keywords": [
    "civic-tech",
    "pwa",
    "on-device-ai",
    "litert",
    "tflite",
    "offline-first",
    "supabase",
    "mapbox",
    "react",
    "typescript"
  ],
  "license": "UNLICENSED",
  "author": "Bruno Jaamaa (https://brunojaamaa.dev)",
  "homepage": "https://github.com/br9704/ripple#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/br9704/ripple.git"
  },
  "bugs": {
    "url": "https://github.com/br9704/ripple/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "sync:wasm": "node scripts/sync-litert-wasm.mjs",
    "prebuild": "node scripts/sync-litert-wasm.mjs && node scripts/fetch-dev-model.mjs",
    "predev": "node scripts/sync-litert-wasm.mjs",
    "verify:db": "./scripts/verify-db.sh",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:lighthouse": "node scripts/verify-lighthouse.mjs",
    "verify": "pnpm test:run && pnpm lint && pnpm build && pnpm verify:pwa && pnpm verify:mobile && pnpm verify:offline",
    "fetch:model": "node scripts/fetch-dev-model.mjs",
    "bench:ai": "node scripts/bench-inference.mjs",
    "capture:media": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@litertjs/core": "^2.5.3",
    "@supabase/supabase-js": "^2.99.3",
    "@turf/turf": "^7.3.4",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "mapbox-gl": "^3.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.27",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  }
}
