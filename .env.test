# Committed on purpose. These are not secrets and never reach a network.
#
# Why this file exists: `src/lib/supabase.ts` throws at module init when
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are absent, so any test whose
# import graph reaches it failed on a clean clone — and `.env.local` is
# gitignored. The result was that `pnpm test:run` gave 334 passing tests on the
# machine that wrote them and 318 plus a failure to everybody else, including CI.
#
# That is the same shape as the vacuous gates recorded in MASTERPLAN S21.10 and
# Sprint D: a green check that depended on untracked local state. A test suite
# a stranger cannot run is not a verified test suite.
#
# Vite loads `.env.test` automatically in test mode, so this needs no wiring.
# Values are deliberately non-resolving — no test should reach a network, and
# one that tries should fail loudly rather than talk to a real project.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=test-anon-key-not-a-real-credential
VITE_MAPBOX_TOKEN=pk.test-token-not-a-real-credential
VITE_VAPID_PUBLIC_KEY=
