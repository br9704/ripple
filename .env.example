# ── Client-safe (bundled into frontend) ──

# Supabase project URL — found in Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=

# Supabase anon/public key — found in Supabase Dashboard > Settings > API
VITE_SUPABASE_ANON_KEY=

# Mapbox public access token — found at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# ── Server-side only (Supabase Edge Function secrets) ──
# These are set in Supabase Dashboard > Edge Functions > Secrets
# DO NOT prefix with VITE_ — they must never reach the client bundle

# Elasticsearch endpoint URL — from your Elastic Cloud deployment
# ELASTICSEARCH_URL=

# Elasticsearch API key — from Elastic Cloud > API Keys
# ELASTICSEARCH_API_KEY=

# Resend API key — from https://resend.com/api-keys
# RESEND_API_KEY=

# Supabase service role key — for Edge Functions that need admin access
# SUPABASE_SERVICE_ROLE_KEY=
